# Required: Supabase project with the Campus Connect migrations applied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only registration key. Store as a secret in Vercel; never use NEXT_PUBLIC_.
SUPABASE_SERVER_SECRET_KEY=
# Optional, reserved for future Gemini recommendations; matching currently uses keywords.
# Server-only; never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
